---
const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === "/") return currentPath === "/";
  return currentPath.startsWith(path);
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-name" aria-label="The Holding Period — home">
      <svg class="site-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M5 4 h14 l-5.5 7 5.5 7 H5 l5.5-7-5.5-7 Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        <line x1="4" y1="4" x2="20" y2="4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <line x1="4" y1="18" x2="20" y2="18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      The Holding Period
    </a>
    <nav aria-label="Main navigation">
      <ul>
        <li>
          <a href="/picks/" class:list={["nav-link", { active: isActive("/picks") }]}>
            Picks
          </a>
        </li>
        <li>
          <a href="/topics/" class:list={["nav-link", { active: isActive("/topics") }]}>
            Topics
          </a>
        </li>
        <li>
          <a href="/about" class:list={["nav-link", { active: isActive("/about") }]}>
            About
          </a>
        </li>
        <li>
          <a href="/contact" class:list={["nav-link", { active: isActive("/contact") }]}>
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 0 var(--page-pad);
  }
  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 1rem;
  }
  .site-name {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .site-name:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .site-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex-shrink: 0;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.5rem;
  }
  .nav-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
    font-weight: 400;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
    text-decoration: none;
  }
  .nav-link.active {
    font-weight: 500;
  }
  @media (max-width: 480px) {
    nav ul {
      gap: 1rem;
    }
    .nav-link {
      font-size: 0.8125rem;
    }
  }
</style>
