---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="disclaimer">
      Returns shown are total return assuming reinvestment of dividends. Stock series use adjusted
      close prices. Benchmark is S&P 500 Total Return index (^SP500TR). Not investment advice.
    </p>
    <div class="footer-bottom">
      <span class="copyright">&copy; {year} The Holding Period</span>
      <nav aria-label="Footer navigation">
        <ul>
          <li><a href="/ledger/">Public ledger</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 2rem var(--page-pad);
    margin-top: 4rem;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .disclaimer {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 680px;
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .copyright {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  nav ul li a {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  nav ul li a:hover {
    color: var(--text);
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
