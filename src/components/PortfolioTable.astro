---
import type { PortfolioStats } from "../lib/data/types.js";
import { CONTRIBUTION_USD } from "../lib/config.js";

interface Props {
  stats: PortfolioStats | null;
}

const { stats } = Astro.props;

function fmtCurrency(val: number): string {
  return val.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
}

function fmtPct(val: number, digits = 1): string {
  const sign = val >= 0 ? "+" : "";
  return `${sign}${(val * 100).toFixed(digits)}%`;
}

const view = stats?.actual ?? null;
---

<section class="portfolio-section">
  <h2 class="section-title">Portfolio</h2>

  {stats === null && (
    <p class="empty-state">No portfolio data yet — data refreshes daily after market close.</p>
  )}

  {stats !== null && (
    <div>
      <p class="view-label">Assumes ${CONTRIBUTION_USD.toLocaleString()} invested per quarter</p>

      <!-- Desktop table -->
      <div class="table-wrapper desktop-only">
        <table class="data-table">
          <thead>
            <tr>
              <th class="num">Total Invested</th>
              <th class="num">Portfolio Value</th>
              <th class="num">Benchmark Value</th>
              <th class="num">Portfolio TR%</th>
              <th class="num">S&P 500 TR%</th>
              <th class="num">Alpha</th>
              <th class="num">Portfolio CAGR</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="num">{fmtCurrency(view?.totalContributions ?? 0)}</td>
              <td class="num">{fmtCurrency(view?.portfolioValue ?? 0)}</td>
              <td class="num">{fmtCurrency(view?.benchmarkValue ?? 0)}</td>
              <td class:list={["num", (view?.portfolioTR ?? 0) >= 0 ? "positive" : "negative"]}>
                {fmtPct(view?.portfolioTR ?? 0)}
              </td>
              <td class:list={["num", (view?.benchmarkTR ?? 0) >= 0 ? "positive" : "negative"]}>
                {fmtPct(view?.benchmarkTR ?? 0)}
              </td>
              <td class:list={["num", (view?.alpha ?? 0) >= 0 ? "positive" : "negative"]}>
                {fmtPct(view?.alpha ?? 0)}
              </td>
              <td class="num">
                {view?.portfolioCagr != null ? (
                  <span class:list={view.portfolioCagr >= 0 ? "positive" : "negative"}>
                    {fmtPct(view.portfolioCagr)}
                  </span>
                ) : (
                  <span class="suppressed" title="CAGR shown only after 1 year of data to avoid misleading annualization.">—</span>
                )}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile stat grid -->
      <div class="stat-grid mobile-only">
        <div class="stat-cell">
          <span class="stat-label">Total Invested</span>
          <span class="stat-value">{fmtCurrency(view?.totalContributions ?? 0)}</span>
        </div>
        <div class="stat-cell">
          <span class="stat-label">Portfolio Value</span>
          <span class="stat-value">{fmtCurrency(view?.portfolioValue ?? 0)}</span>
        </div>
        <div class="stat-cell">
          <span class="stat-label">Benchmark Value</span>
          <span class="stat-value">{fmtCurrency(view?.benchmarkValue ?? 0)}</span>
        </div>
        <div class="stat-cell">
          <span class="stat-label">Portfolio TR</span>
          <span class:list={["stat-value", (view?.portfolioTR ?? 0) >= 0 ? "positive" : "negative"]}>
            {fmtPct(view?.portfolioTR ?? 0)}
          </span>
        </div>
        <div class="stat-cell">
          <span class="stat-label">S&P 500 TR</span>
          <span class:list={["stat-value", (view?.benchmarkTR ?? 0) >= 0 ? "positive" : "negative"]}>
            {fmtPct(view?.benchmarkTR ?? 0)}
          </span>
        </div>
        <div class="stat-cell">
          <span class="stat-label">Alpha</span>
          <span class:list={["stat-value", (view?.alpha ?? 0) >= 0 ? "positive" : "negative"]}>
            {fmtPct(view?.alpha ?? 0)}
          </span>
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .portfolio-section {
    margin-top: 2.5rem;
  }
  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--text);
  }
  .view-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }
  .empty-state {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    min-width: 680px;
  }
  .data-table thead th {
    padding: 0.625rem 0.875rem;
    text-align: right;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .data-table td {
    padding: 0.875rem 0.875rem;
    color: var(--text);
  }
  .data-table td.num {
    text-align: right;
  }
  .positive { color: var(--green); }
  .negative { color: var(--red); }
  .suppressed {
    color: var(--text-muted);
    cursor: help;
    border-bottom: 1px dashed var(--border);
  }

  /* Responsive visibility */
  .mobile-only { display: none; }

  @media (max-width: 680px) {
    .desktop-only { display: none; }
    .mobile-only { display: grid; }

    .stat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
    }
    .stat-cell {
      padding: 0.875rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .stat-cell:nth-child(3n) {
      border-right: none;
    }
    .stat-cell:nth-last-child(-n+3) {
      border-bottom: none;
    }
    .stat-label {
      font-size: 0.625rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }
    .stat-value {
      font-size: 0.9375rem;
      font-weight: 600;
      color: var(--text);
    }
  }
</style>
