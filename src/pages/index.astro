---
export const prerender = true;

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import { homePageMeta } from "../lib/seo/meta.js";
import "../styles/global.css";

const meta = homePageMeta();
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header />

    <main>
      <p>
        Most stocks do not create lasting wealth. Hendrik Bessembinder's research shows that over
        long periods, more than half of public companies have negative lifetime returns, while a
        very small number of exceptional businesses drive nearly all market wealth creation. The
        Holding Period is a search for what may be worth holding for 25 years and an attempt to
        define what is not.
      </p>

      <nav aria-label="Site navigation">
        <div class="nav-links">
          <a href="/research/">Research</a>
          <div class="nav-dropdown">
            <a href="/approach/25-year-hold-thesis/">Investment Approach</a>
            <div class="nav-dropdown-menu">
              <a href="/approach/25-year-hold-thesis/">The 25-Year Hold Thesis</a>
              <a href="/approach/negative-portfolio/">The Negative Portfolio</a>
            </div>
          </div>
        </div>
      </nav>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  p {
    font-size: 0.9375rem;
    color: #2c2c3e;
    line-height: 1.8;
    margin-bottom: 48px;
    text-wrap: pretty;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .nav-links > a,
  .nav-dropdown > a {
    color: #1a3a6b;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    display: inline-block;
  }

  .nav-links > a:hover,
  .nav-dropdown > a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nav-links > a::before,
  .nav-dropdown > a::before {
    content: "→\00a0";
    font-size: 0.75rem;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-menu {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding-left: 28px;
    margin-top: 10px;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    display: flex;
  }

  .nav-dropdown-menu a {
    color: #4a5a7a;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 400;
    display: inline-block;
  }

  .nav-dropdown-menu a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nav-dropdown-menu a::before {
    content: "→\00a0";
    font-size: 0.7rem;
  }
</style>
