---
export const prerender = true;

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import { homePageMeta } from "../lib/seo/meta.js";
import "../styles/global.css";

const meta = homePageMeta();
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header />

    <main>
      <p>
        Most stocks do not create lasting wealth. A small minority of public companies drives the
        long-run market, but finding them is only half the problem. The other half is behavioral:
        buying with one time frame, judging with another, and selling when price movement
        overwhelms the original thesis.
      </p>

      <p>
        The Holding Period starts by fixing the clock: five years for tangible business change,
        twenty-five years for the more extreme test of survival, adaptability, and compounding.
      </p>

      <nav aria-label="Site navigation">
        <div class="nav-links">
          <a href="/research/">Research</a>
          <a href="/approach/5-year-hold/">Investment Approach: Hold Period of 5 Years</a>
          <a href="/approach/25-year-hold-thesis/">Investment Approach: Hold Period of 25 Years</a>
        </div>
      </nav>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 2rem 6rem;
  }

  p {
    font-size: 0.9375rem;
    color: #2c2c3e;
    line-height: 1.8;
    margin-bottom: 24px;
    text-wrap: pretty;
  }

  p:last-of-type {
    margin-bottom: 48px;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nav-links > a {
    color: #1a3a6b;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    display: inline-block;
  }

  .nav-links > a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nav-links > a::before {
    content: "→\00a0";
    font-size: 0.75rem;
  }
</style>
