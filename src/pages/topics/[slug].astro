---
export const prerender = true;

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEOHead from "../../components/SEOHead.astro";
import { topicPageMeta } from "../../lib/seo/meta.js";
import { topics } from "../../content/topics.js";
import "../../styles/global.css";

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const meta = topicPageMeta(topic);
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header />

    <main class="page-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/topics/">Topics</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">{topic.title}</li>
        </ol>
      </nav>

      <article class="topic-article">
        <header class="topic-header">
          <h1>{topic.title}</h1>
          <p class="topic-desc">{topic.description}</p>
        </header>

        {topic.comingSoon && (
          <div class="coming-soon-block">
            <p>
              This topic is being developed. The frameworks and analysis will be published here
              as they're written.
            </p>
            <p>
              In the meantime, the <a href="/picks/">quarterly picks</a> apply these ideas in
              practice, and the <a href="/about">methodology</a> explains the underlying investment
              framework.
            </p>
          </div>
        )}
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--page-pad) 4rem;
  }
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .breadcrumb li {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .breadcrumb [aria-current="page"] {
    color: var(--text);
  }
  .topic-article {
    max-width: 680px;
  }
  .topic-header {
    padding: 0 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .topic-header h1 {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .topic-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .coming-soon-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .coming-soon-block p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .coming-soon-block a {
    color: var(--accent);
  }
</style>
