---
export const prerender = true;

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEOHead from "../../components/SEOHead.astro";
import { researchIndexMeta } from "../../lib/seo/meta.js";
import { researchArticles } from "../../content/research.js";
import "../../styles/global.css";

const meta = researchIndexMeta();

const twentyFive = researchArticles.filter((a) => a.group === "25-year");
const shared = researchArticles.filter((a) => a.group === "shared");
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header />

    <main class="page-main">
      <div class="page-header">
        <h1>Research</h1>
        <p class="page-desc">
          Frameworks, company studies, and evidence files for long-duration public equity
          research, grouped by horizon. The archive is meant to compound.
        </p>
      </div>

      <section class="research-group">
        <h2 class="group-title">Five-Year Winners</h2>
        <p class="group-intro">
          The practical research lane: measurable five-year business change, underwritten before it
          is consensus.
        </p>
        <ul class="article-list">
          <li class="article-item">
            <a href="/approach/5-year-hold/" class="article-link">
              <div class="article-body">
                <span class="article-title">Investment Approach: Hold Period of 5 Years</span>
                <span class="article-desc">
                  S-curves and the AI stack, return decomposition, the 10% base-case hurdle without
                  multiple expansion, false-inflection discipline, and the pilot scorecard queue
                  (NVDA, VRT, MU, APP).
                </span>
              </div>
              <span class="article-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
        <p class="group-note">
          A ranked historical five-year winners table is intentionally not published yet. The data
          path is unresolved, and a survivor-only ranking would mislead more than it informs.
          Standalone five-year research files will be added as the framework clears pilot
          validation.
        </p>
      </section>

      <section class="research-group">
        <h2 class="group-title">Twenty-Five-Year Experiment</h2>
        <ul class="article-list">
          {twentyFive.map((article) => (
            <li class="article-item">
              <a href={`/research/${article.slug}/`} class="article-link">
                <div class="article-body">
                  <span class="article-title">{article.title}</span>
                  <span class="article-desc">{article.description}</span>
                </div>
                <span class="article-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="research-group">
        <h2 class="group-title">Shared Base Rates and Failure Work</h2>
        <ul class="article-list">
          {shared.map((article) => (
            <li class="article-item">
              <a href={`/research/${article.slug}/`} class="article-link">
                <div class="article-body">
                  <span class="article-title">{article.title}</span>
                  <span class="article-desc">{article.description}</span>
                </div>
                <span class="article-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--page-pad) 4rem;
  }
  .page-header {
    padding: 2rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    max-width: 640px;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .page-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .research-group {
    max-width: 720px;
    margin-bottom: 2.75rem;
  }
  .group-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }
  .group-intro {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
  .group-note {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0.875rem 0 0;
  }
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .article-item {
    border-bottom: 1px solid var(--border);
  }
  .article-item:first-child {
    border-top: 1px solid var(--border);
  }
  .article-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
  }
  .article-link:hover .article-title {
    color: var(--accent);
  }
  .article-link:hover {
    text-decoration: none;
  }
  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .article-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
    transition: color 0.15s;
  }
  .article-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .article-arrow {
    font-size: 1rem;
    color: var(--text-muted);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
</style>
