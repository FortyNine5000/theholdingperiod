---
export const prerender = true;

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";
import { faqPageMeta } from "../lib/seo/meta.js";
import { faqs } from "../content/faqs.js";
import "../styles/global.css";

const meta = faqPageMeta();

// Group FAQs by category
const categories = [...new Set(faqs.map((f) => f.category ?? "General"))];

// Build FAQPage JSON-LD (injected via meta already, but also build inline for clarity)
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </head>
  <body>
    <Header />

    <main class="page-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">FAQ</li>
        </ol>
      </nav>

      <div class="page-header">
        <h1>Frequently Asked Questions</h1>
        <p class="page-desc">
          How the picks work, how returns are calculated, and what this site is and isn't.
        </p>
      </div>

      {categories.map((category) => (
        <section class="faq-section">
          <h2 class="category-heading">{category}</h2>
          <dl class="faq-list">
            {faqs
              .filter((f) => (f.category ?? "General") === category)
              .map((faq) => (
                <div class="faq-item">
                  <dt class="faq-question">{faq.question}</dt>
                  <dd class="faq-answer">{faq.answer}</dd>
                </div>
              ))}
          </dl>
        </section>
      ))}

      <p class="more-link">
        More questions? <a href="/contact">Get in touch.</a>
      </p>
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--page-pad) 4rem;
  }
  .breadcrumb {
    margin-bottom: 2rem;
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .breadcrumb li {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .breadcrumb [aria-current="page"] {
    color: var(--text);
  }
  .page-header {
    padding: 0 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
    max-width: 640px;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .faq-section {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }
  .category-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .faq-list {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .faq-item {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0;
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .faq-question {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }
  .faq-answer {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0;
  }
  .more-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 1rem;
  }
  .more-link a {
    color: var(--accent);
  }
</style>
