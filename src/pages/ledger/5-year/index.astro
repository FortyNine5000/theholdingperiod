---
export const prerender = true;

import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SEOHead from "../../../components/SEOHead.astro";
import { ledger5YearMeta } from "../../../lib/seo/meta.js";
import "../../../styles/global.css";

const meta = ledger5YearMeta();

// Five-year holding-period decisions, recorded as a static audit trail.
// Not a recommendation.
const rows = [
  {
    quarter: "2026 Q2",
    ticker: "GOOG",
    company: "Alphabet Inc.",
    entryDate: "2026-06-10",
    entryPrice: "$358.10",
    plannedExit: "2031-06-10",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Public Ledgers", href: "/ledger/" },
      { label: "The 5-Year Ledger" },
    ]} />

    <main class="page-main">
      <div class="ledger-intro">
        <h1>The 5-Year Ledger</h1>
        <p>
          This ledger records five-year holding-period decisions as an audit trail. Each entry
          records the ticker, the entry date and price, and the planned five-year exit. The
          five-year framework itself is described on the approach page.
        </p>
        <p class="ledger-note">
          Not investment advice. Nothing here should be read as a recommendation to buy or sell any
          security.
        </p>
      </div>

      <section class="ledger-table-section">
        <div class="table-wrapper desktop-only">
          <table class="data-table">
            <thead>
              <tr>
                <th>Quarter</th>
                <th>Ticker</th>
                <th>Company</th>
                <th>Entry Date</th>
                <th class="num">Entry Price</th>
                <th>Planned Exit</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td class="quarter">{r.quarter}</td>
                  <td class="ticker">{r.ticker}</td>
                  <td>{r.company}</td>
                  <td>{r.entryDate}</td>
                  <td class="num">{r.entryPrice}</td>
                  <td>{r.plannedExit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="cards-list mobile-only">
          {rows.map((r) => (
            <div class="ledger-card">
              <div class="card-header">
                <span class="card-ticker">{r.ticker}</span>
                <span class="card-quarter">{r.quarter}</span>
              </div>
              <p class="card-company">{r.company}</p>
              <dl class="card-rows">
                <div><dt>Entry date</dt><dd>{r.entryDate}</dd></div>
                <div><dt>Entry price</dt><dd>{r.entryPrice}</dd></div>
                <div><dt>Planned exit</dt><dd>{r.plannedExit}</dd></div>
              </dl>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--page-pad) 4rem;
  }
  .ledger-intro {
    max-width: 640px;
    padding: 2rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .ledger-intro h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .ledger-intro p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .ledger-note {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
  }
  .table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    min-width: 560px;
  }
  .data-table thead th {
    padding: 0.625rem 0.875rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .data-table th.num,
  .data-table td.num {
    text-align: right;
  }
  .data-table td {
    padding: 0.75rem 0.875rem;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }
  .data-table tbody tr:last-child td {
    border-bottom: none;
  }
  .ticker {
    color: var(--accent);
    font-weight: 500;
  }
  .quarter {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .mobile-only { display: none; }
  @media (max-width: 680px) {
    .desktop-only { display: none; }
    .mobile-only { display: flex; flex-direction: column; gap: 0.75rem; }
    .ledger-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
    }
    .card-header {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
    }
    .card-ticker {
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--accent);
    }
    .card-quarter {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .card-company {
      margin: 0.25rem 0 0.75rem;
      font-size: 0.875rem;
      color: var(--text-muted);
    }
    .card-rows {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .card-rows > div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }
    .card-rows dt {
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .card-rows dd {
      margin: 0;
      font-size: 0.8125rem;
      color: var(--text);
      text-align: right;
    }
  }
</style>
