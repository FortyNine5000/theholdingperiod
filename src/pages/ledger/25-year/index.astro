---
export const prerender = false;

import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SEOHead from "../../../components/SEOHead.astro";
import PicksTable from "../../../components/PicksTable.astro";
import PortfolioTable from "../../../components/PortfolioTable.astro";
import { ledger25YearMeta } from "../../../lib/seo/meta.js";
import { getComputedPicks, getComputedPortfolio, getLastRefresh } from "../../../lib/store.js";
import { picks } from "../../../content/picks.js";
import type { PickStats } from "../../../lib/data/types.js";
import "../../../styles/global.css";

const kv = Astro.locals.runtime.env.HOLDING_PERIOD_KV;

const [computedPicks, portfolio, lastRefresh] = await Promise.all([
  getComputedPicks(kv),
  getComputedPortfolio(kv),
  getLastRefresh(kv),
]);

const meta = ledger25YearMeta();

// Render the canonical roster in order. Use the live KV-computed stats when
// present; for a name entered since the last daily refresh (e.g. a brand-new
// quarterly name with a recorded entry), synthesize the row from its recorded
// entry so it appears on the ledger immediately. The S&P 500 TR benchmark is
// taken at the entry date (today's open for a same-day entry), so a freshly
// entered name starts at 0% until the next daily close updates it.
const computedById = new Map((computedPicks ?? []).map((s) => [s.id, s]));
const displayPicks: PickStats[] = picks.flatMap((p) => {
  const live = computedById.get(p.id);
  if (live) return [live];
  if (!p.entryOverride) return [];
  return [
    {
      id: p.id,
      ticker: p.ticker,
      companyName: p.companyName,
      quarterLabel: p.quarterLabel,
      entryDate: p.entryOverride.date,
      entryPrice: p.entryOverride.price,
      currentPrice: p.entryOverride.price,
      cumReturn: 0,
      cagr: null,
      benchmarkReturn: 0,
      alpha: 0,
      evidenceLabel: p.evidenceLabel,
      chartDates: [],
      chartPickValues: [],
      chartBenchmarkValues: [],
    },
  ];
});
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Public Ledgers", href: "/ledger/" },
      { label: "25-Year Public Ledger" },
    ]} />

    <main class="page-main">
      <div class="ledger-intro">
        <h1>25-Year Public Ledger</h1>
        <p>
          One public company per quarter enters the 25-year experiment. The entry date, entry
          price, benchmark value, evidence label, and thesis source are recorded so the decision
          cannot be quietly revised after the fact. Names remain on record for 25 years from the
          date they are entered — including drawdowns, mistakes, and underperformance.
        </p>
        <p class="ledger-note">
          The public ledger is the audit trail, not a model portfolio. It is not investment
          advice. Nothing here should be read as a recommendation to buy or sell any security. A
          newly entered name shows its recorded entry immediately; live performance and the
          S&amp;P 500 TR comparison begin updating at the next daily close.
        </p>
      </div>

      <PicksTable picks={displayPicks} lastRefresh={lastRefresh} />
      <PortfolioTable stats={portfolio} />
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--page-pad) 4rem;
  }
  .ledger-intro {
    max-width: 640px;
    padding: 2rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .ledger-intro h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .ledger-intro p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.75;
  }
  .ledger-note {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
  }
</style>
