---
export const prerender = true;

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SEOHead from "../../components/SEOHead.astro";
import { picksIndexMeta } from "../../lib/seo/meta.js";
import { picks } from "../../content/picks.js";
import "../../styles/global.css";

const meta = picksIndexMeta();

// Show most recent pick first
const sortedPicks = [...picks].reverse();
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead meta={meta} />
  </head>
  <body>
    <Header />

    <main class="page-main">
      <div class="page-header">
        <h1>Picks</h1>
        <p class="page-desc">
          Every quarterly pick from day one, tracked against the S&P 500 Total Return index.
          One pick per quarter. No rebalancing. The record is public and unedited.
        </p>
      </div>

      <ul class="picks-list">
        {sortedPicks.map((pick) => (
          <li class="pick-item">
            <a href={`/picks/${pick.id}`} class="pick-link">
              <div class="pick-meta">
                <span class="pick-quarter">{pick.quarterLabel}</span>
                <span class="pick-ticker">{pick.ticker}</span>
              </div>
              <div class="pick-body">
                <span class="pick-company">{pick.companyName}</span>
                <span class="pick-headline">{pick.thesisHeadline}</span>
              </div>
              <span class="pick-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <Footer />
  </body>
</html>

<style>
  .page-main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--page-pad) 4rem;
  }
  .page-header {
    padding: 2rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    max-width: 640px;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .picks-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .pick-item {
    border-bottom: 1px solid var(--border);
  }
  .pick-link {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
    transition: background 0.1s;
  }
  .pick-link:hover {
    text-decoration: none;
  }
  .pick-link:hover .pick-company {
    color: var(--accent);
  }
  .pick-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 90px;
  }
  .pick-quarter {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .pick-ticker {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .pick-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .pick-company {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.15s;
  }
  .pick-headline {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .pick-arrow {
    font-size: 1rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  @media (max-width: 600px) {
    .pick-link {
      gap: 1rem;
    }
    .pick-meta {
      min-width: 72px;
    }
  }
</style>
